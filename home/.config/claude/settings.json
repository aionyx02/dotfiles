{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 60,
  "env": {
    "EDITOR": "subl -w"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "PowerShell(Get-Command *)",
      "PowerShell(Get-Process *)",
      "PowerShell(Get-CimInstance *)",
      "PowerShell(zoxide *)",
      "Bash(rtk ls *)",
      "Bash(rtk read *)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rtk git push --force:*)",
      "Bash(rtk git push -f:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rtk git reset --hard:*)",
      "PowerShell(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(rtk git clean -f:*)",
      "PowerShell(git clean -f:*)",
      "Bash(git branch -D:*)",
      "Bash(rtk git branch -D:*)",
      "PowerShell(git branch -D:*)",
      "Bash(git checkout .)",
      "Bash(rtk git checkout .)",
      "PowerShell(git checkout .)",
      "Bash(git restore .)",
      "Bash(rtk git restore .)",
      "PowerShell(git restore .)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.config/claude/.credentials.json)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "PowerShell(Remove-Item * -Recurse *)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(rtk git push:*)",
      "PowerShell(git push:*)"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "\"C:/Program Files/nodejs/node.exe\" \"C:/Users/shawn/AppData/Roaming/npm/node_modules/ccstatusline/dist/ccstatusline.js\"",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "autoCompactWindow": 700000
    }
  },
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "theme": "dark",
  "preferredNotifChannel": "terminal_bell",
  "agentPushNotifEnabled": true,
  "switchModelsOnFlag": true
}
