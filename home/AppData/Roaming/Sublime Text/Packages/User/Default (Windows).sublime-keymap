[
	// ── Markdown 預覽 ──────────────────────────────────────────
	// Alt+M：以瀏覽器開啟預覽（僅在 Markdown 檔案中生效）
	{
		"keys": ["alt+m"],
		"command": "markdown_preview",
		"args":
		{
			"target": "browser",
			"parser": "markdown",
		},
		"context":
		[
			{ "key": "selector", "operator": "equal", "operand": "text.html.markdown" },
		],
	},
]
