{
	// 注意：Markdown 行尾的兩個空白是強制換行語法，
	//   不可啟用自動移除行尾空白，否則會破壞文件排版。
	"trim_trailing_white_space_on_save": "none",

	// 依視窗寬度自動換行
	"word_wrap": true,
	"wrap_width": 0,
	"rulers": [],

	// 關閉拼字檢查：中英混合的技術文件會產生大量誤報
	// 需要時可按 F6 暫時開啟
	"spell_check": false,

	"tab_size": 2,
	"translate_tabs_to_spaces": true,
	"ensure_newline_at_eof_on_save": true,
}
