{
	// 在本機算繪，不呼叫 GitHub API：不需要網路，也沒有每小時 60 次的速率限制
	"parser": "markdown",

	// 啟用接近 HackMD（GFM）的擴充功能
	"enable_highlight": true,
	"markdown_extensions":
	[
		"markdown.extensions.abbr",
		"markdown.extensions.attr_list",
		"markdown.extensions.def_list",
		"markdown.extensions.footnotes",
		"markdown.extensions.tables",
		"markdown.extensions.toc",
		{
			"markdown.extensions.admonition": {},
		},
		{
			"markdown.extensions.codehilite":
			{
				"guess_lang": false,
			},
		},
		{
			"pymdownx.superfences": {},
		},
		{
			"pymdownx.magiclink": {},
		},
		{
			"pymdownx.tasklist":
			{
				"custom_checkbox": true,
			},
		},
		{
			"pymdownx.tilde": {},
		},
		{
			"pymdownx.caret": {},
		},
	],

	// 中文文件：設定 CJK 遞補字型，避免預覽出現缺字方框
	"css":
	[
		"default",
	],
	"allow_css_overrides": true,

	// 存檔時自動更新已開啟的預覽分頁
	"enable_autoreload": true,

	// 預覽輸出至暫存檔，不會在專案資料夾中產生 .html 檔
	"build_action": "browser",
	"image_path_conversion": "absolute",
	"file_path_conversions": "absolute",
}
