{
	// ── 字型與版面 ─────────────────────────────────────────────
	// JetBrains Mono NL 為無連字版本，避免 != 與 => 在設定檔中顯示為合字符號
	"font_face": "JetBrains Mono NL",
	"font_size": 16,
	"line_padding_top": 1,
	"line_padding_bottom": 2,

	// ── 配色 ───────────────────────────────────────────────────
	// 自訂配色，色值取自 wezterm.lua 的 Tokyo Night
	"color_scheme": "Packages/User/Tokyo Night.sublime-color-scheme",
	// Adaptive 會依配色方案的背景色推導整個介面的顏色，
	// 因此分頁列、狀態列與側邊欄會自動套用 Tokyo Night，不會出現灰色介面搭配深藍編輯區。
	// （Default Dark 使用獨立的灰階色系，因此與配色方案不一致。）
	// 細部調整位於 Packages/User/Adaptive.sublime-theme
	"theme": "Adaptive.sublime-theme",

	// ── symlink 相容性（必要設定，非個人偏好）───────────────────
	// Sublime 預設的 atomic save 會先寫入暫存檔，再以 rename 覆蓋原檔。
	// rename 覆蓋的是 symlink 本身而非其目標，因此只要以 Sublime
	// 儲存過一次 ~/.config/ 下的檔案，該連結就會被替換為實體檔案，
	// 此後在 dotfiles repo 中的修改不再生效，且 git status 不會顯示任何變化。
	// 因此停用此功能。非原子寫入的風險（寫入途中當機）對有 git 管理的小型設定檔而言可以接受。
	// 另見：dotfiles repo 的 install.ps1 -Verify 可找出已失效的連結。
	"atomic_save": false,

	// ── 視覺輔助（僅影響顯示，不修改檔案內容）───────────────────
	"highlight_line": true,
	"highlight_modified_tabs": true,
	"caret_style": "phase",
	"scroll_past_end": true,
	"draw_white_space": ["selection", "trailing"],

	// ── 上方：分頁列 ───────────────────────────────────────────
	// 方角分頁（WezTerm 的分頁為圓角，兩者風格不同）
	"file_tab_style": "square",
	// 顯示分頁的關閉按鈕
	"show_tab_close_buttons": true,
	// 明確啟用選單列與標題列，避免受其他設定或佈景影響
	"menu_visible": true,
	"themed_title_bar": true,

	// ── 下方：狀態列 ───────────────────────────────────────────
	// 以下兩項 Sublime 預設為關閉，此處特別啟用：
	//   show_encoding    ：中文檔案若以 Big5 開啟會出現亂碼，此為唯一的即時提示
	//   show_line_endings：CRLF 混入 git repo 會使整個檔案在 diff 中顯示為變更
	"show_encoding": true,
	"show_line_endings": true,
	"show_line_column": "enabled",
	"show_indentation": true,
	"show_git_status": true,
	"show_git_status_in_status_bar": true,
	"auto_hide_status_bar": false,

	// ── 索引與搜尋效能 ─────────────────────────────────────────
	// D:\Project\python 有超過 27 萬個檔案，若無以下排除規則，
	// Goto Anything（Ctrl+P）的結果會被 node_modules 等目錄淹沒
	"index_files": true,
	"goto_anything_exclude_gitignore": true,

	"folder_exclude_patterns":
	[
		".svn", ".git", ".hg", "CVS", ".Trash", ".Trash-*",
		"node_modules",
		"__pycache__",
		".venv", "venv", "env",
		"site-packages",
		".mypy_cache", ".pytest_cache", ".ruff_cache",
		"dist", "build", ".next", "out",
		".idea",
		"target",
	],

	"binary_file_patterns":
	[
		"*.jpg", "*.jpeg", "*.png", "*.gif", "*.ttf", "*.tga",
		"*.dds", "*.ico", "*.eot", "*.pdf", "*.swf", "*.jar", "*.zip",
		"*.pyc", "*.pyo", "*.exe", "*.dll", "*.obj", "*.o", "*.a", "*.lib",
		"*.map", "*.min.js", "*.min.css",
	],

	"index_exclude_patterns":
	[
		"*.log",
		"*.min.js", "*.min.css", "*.map",
		"*.pyc",
	],

	// ── 其他設定 ───────────────────────────────────────────────
	"ignored_packages":
	[
		"Vintage",
	],
	"file_icon_theme": "A File Icon (Mono).sublime-file-icons",
}
